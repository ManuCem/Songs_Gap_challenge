rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in user can only read and write their own results.
    match /users/{uid}/results/{resultId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['title', 'correct', 'total', 'pct', 'missed', 'updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.correct is int && request.resource.data.total is int
        && request.resource.data.pct is int
        && request.resource.data.missed is list && request.resource.data.missed.size() <= 200
        && request.resource.data.updatedAt == request.time;
    }

    // Everything else is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
