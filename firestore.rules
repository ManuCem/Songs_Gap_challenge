rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function d() { return request.resource.data; }

    // Profile: XP and daily streak. Only you can read/write yours.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && d().keys().hasOnly(['xp', 'streak', 'lastPlayed', 'updatedAt'])
        && d().xp is int && d().xp >= 0
        && d().streak is int && d().streak >= 0
        && d().lastPlayed is string && d().lastPlayed.size() <= 10
        && d().updatedAt == request.time;

      // Results of each challenge
      match /results/{resultId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && d().keys().hasOnly(['title', 'artist', 'songId', 'correct', 'total', 'pct', 'missed', 'missedPairs',
                                 'mode', 'preset', 'seconds', 'hints', 'tries', 'scores', 'lastChance', 'finished',
                                 'multi', 'room', 'place', 'players', 'points', 'updatedAt'])
          && d().title is string && d().title.size() <= 200
          && d().correct is int && d().total is int && d().pct is int
          && d().missed is list && d().missed.size() <= 200
          && (!('missedPairs' in d()) || (d().missedPairs is list && d().missedPairs.size() <= 100))
          && (!('scores' in d()) || (d().scores is list && d().scores.size() <= 50))
          && d().updatedAt == request.time;
      }

      // Library: saved songs with labels
      match /songs/{songKey} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && d().keys().hasOnly(['title', 'artist', 'songId', 'lyrics', 'cover', 'youtube', 'offset',
                                 'tags', 'best', 'plays', 'updatedAt'])
          && d().title is string && d().title.size() <= 200
          && d().tags is list && d().tags.size() <= 12
          && (!('lyrics' in d()) || (d().lyrics is string && d().lyrics.size() <= 30000))
          && d().updatedAt == request.time;
      }
    }

    // Leaderboards: every signed-in user can read; you can only write your own score.
    match /leaderboards/{board}/scores/{uid} {
      allow read: if signedIn();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && d().keys().hasOnly(['name', 'pct', 'tries', 'hints', 'rank', 'updatedAt'])
        && d().name is string && d().name.size() <= 40
        && d().pct is int && d().pct >= 0 && d().pct <= 100
        && d().tries is int && d().tries >= 0
        && d().hints is int && d().hints >= 0
        && d().rank is number
        && d().updatedAt == request.time;
    }

    // 👥 Multiplayer rooms. Anyone signed in (guests too) can read a room;
    // only the host changes it. Each player only writes their own score.
    match /rooms/{code} {
      function room() { return get(/databases/$(database)/documents/rooms/$(code)).data; }
      function validPlayer() {
        return d().keys().hasOnly(['name', 'team', 'joinedAt', 'points', 'correct', 'total', 'hints', 'misses',
                                   'combo', 'left', 'tries', 'updatedAt'])
          && d().name is string && d().name.size() > 0 && d().name.size() <= 24
          && (!('points' in d()) || d().points is number)
          && (!('tries' in d()) || (d().tries is list && d().tries.size() <= 20));
      }

      allow read: if signedIn();
      allow create: if signedIn() && code.size() >= 4 && code.size() <= 8
        && d().host == request.auth.uid && d().status == 'lobby';
      allow update: if signedIn() && resource.data.host == request.auth.uid && d().host == resource.data.host;
      allow delete: if signedIn() && resource.data.host == request.auth.uid;

      match /players/{pid} {
        allow read: if signedIn();
        allow create: if isOwner(pid) && room().status == 'lobby' && room().locked == false
          && !(pid in room().banned) && validPlayer();
        allow update: if isOwner(pid) && !(pid in room().banned) && validPlayer();
        allow delete: if isOwner(pid) || (signedIn() && room().host == request.auth.uid);
      }
    }

    // Everything else is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
