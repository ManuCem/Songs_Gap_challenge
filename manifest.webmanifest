{
  "name": "Lyrics Gap Challenge",
  "short_name": "LyricsGap",
  "description": "Learn English with songs: fill in the missing lyrics while you listen.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0d0e11",
